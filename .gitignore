# Theory of Computer Science - Academic Repository
# Specialized .gitignore for automata theory and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# JFLAP (Automata Theory Tool)
*.jff.bak
*.jff~

# LaTeX / Document Artifacts
*.aux
*.bbl
*.blg
*.idx
*.ind
*.lof
*.lot
*.out
*.toc
*.log
*.synctex.gz
*.pdf
# Note: Usually we keep the final PDF for academic reports, 
# but ignore intermediate build files. 
# If PDFs are shared as 'source' in this repo, remove *.pdf from here.
# Given the directory structure, keep manually added PDFs.

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Temporary and Cache files
*.tmp
*.log
.cache/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
